#!/bin/sh
# Source-checkout convenience launcher. Releases install the compiled executable.
set -eu
base=$(CDPATH= cd -- "$(dirname -- "$0")/.." && pwd)
if [ ! -x "$base/dist/sess" ]; then
    printf 'sess has moved to Go + zmx. Run make build in %s first.\n' "$base" >&2
    exit 1
fi
exec "$base/dist/sess" "$@"
